# Copiez ce fichier en `.env.local` (gitignored) pour le développement local.
# Ne commitez JAMAIS de valeur réelle.
#
# Base PostgreSQL locale (Docker Compose, service db, port 5435).
# Ne jamais pointer DATABASE_URL vers Neon en développement.
DATABASE_URL="postgres://postgres:localtest@127.0.0.1:5435/umpj_s1_test"

# Secret de session (générez le vôtre, 32 octets minimum).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

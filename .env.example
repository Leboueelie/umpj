# Copiez ce fichier en `.env` et renseignez vos valeurs.
# Obtenez la chaîne de connexion Neon dans le dashboard Neon
# (onglet Connection, paramètres "Node" ou "pooled").
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secret de signature des sessions (obligatoire, 32 caractères minimum —
# 32 octets aléatoires recommandés).
# Générez-le localement, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Configurez la même variable dans Vercel (Settings > Environment Variables).
# Ne jamais committer de secret réel.
AUTH_SECRET=

# Garde globale (proxy.ts) : "tout" (par défaut) protège pages et API.
# "off" n'est ignoré qu'en développement (incident documenté) : il est
# sans effet en production, où la garde reste toujours active.
# AUTH_GARDE=tout

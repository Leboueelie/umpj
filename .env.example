# Copiez ce fichier en `.env` et renseignez vos valeurs.
# Obtenez la chaîne de connexion Neon dans le dashboard Neon
# (onglet Connection, paramètres "Node" ou "pooled").
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secret de signature des sessions (obligatoire).
# Générez-le localement, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Configurez la même variable dans Vercel (Settings > Environment Variables).
# Ne jamais committer de secret réel.
AUTH_SECRET=

# Garde globale (proxy.ts) : "tout" (par défaut) protège pages et API ;
# "off" ne doit être utilisé qu'en incident documenté (rouvre l'application).
# AUTH_GARDE=tout
